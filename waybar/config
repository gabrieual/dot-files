{
    "height": 0,
    //"position": "left",
    //"position": "bottom",
    "margin-left":0,
    "margin-right":0,
    "margin-bottom":-2,
    "margin-top":0,

    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],

    "modules-center": [
        "clock", 
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "memory",
        "temperature",
        "battery",
    ],

    "hyprland/window": {
      "format": "{}",
      "on-empty": "hidden",
      "tooltip": false,
      "max-length": 50,
      "rewrite":{
          "~":"kitty",
        },
    },
    
    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      //"format-icons": {
      //  "active": "",
      //},
      "sort-by-number": true,
      "persistent-workspaces": {
        "*": 4, // 5 workspaces by default on every monitor
        "HDMI-A-1": 3 // but only three on HDMI-A-1
      }
    },
    

    "mpris": {
      "format": "󰎇 {status_icon} {dynamic}",
      "dynamic-len": 43,
	    "status-icons": {
		    "playing": "⏸",
		    "paused": "▶",
		    "stopped": ""
	      },
	    "dynamic-order": ["title", "artist"],
      "ignored-players": ["firefox"]
    },


    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%d %h %H:%M}"
    },


    "cpu": {
      "format": " {usage}%",
      "tooltip": false
    },


    "memory": {
      "format": "  {}%",
      "on-click": "kitty -- btop",
      "interval": 5
    },


    "temperature": {
      "critical-threshold": 75,
      "format": "{icon} {temperatureC}°C",
      "format-icons": ["", "", ""]
    },


    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon}  {capacity}%",
      "format-full": "{icon}  {capacity}%",
      "format-charging": "󱐋 {capacity}%",
      "format-plugged": " {capacity}%",
      "format-alt": "{icon} {time}",
      "format-icons": ["", "", "", "", ""]
    },


    "network": {
      "format-wifi": "{icon}  {essid}",
      "format-ethernet": "{cidr} 󰈁",
      "tooltip-format": "{ifname} via {gwaddr} 󰈁",
      "format-linked": "{ifname} (No IP) 󰈁",
      "format-disconnected": "",
      "max-length": 11,
      "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
      "on-click": "kitty -- impala"
    },


    "pulseaudio": {
      "format": "{format_source}  {icon} {volume}%",
      "format-source": "",
      "format-source-muted": " ",
      "format-bluetooth": "{volume}% {icon} {format_source}",
      "format-bluetooth-muted": "󰝟 {icon} {format_source}",
      "format-muted": " ",
      "format-icons": {
        "headphone": " ",
        "hands-free": "",
        "headset": " ",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", " ", " "]
      },
      "on-click": "pavucontrol"
    },

    "custom/powermenu": {
      "format": "",
      "on-click": "$HOME/.scripts/toggle-powermenu.sh",
      "tooltip":false
    }
}
